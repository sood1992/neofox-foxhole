<script>
    // Tab management
    function showTab(tabId, event) {
        // Prevent default link behavior if event exists
        if (event) {
            event.preventDefault();
        }
        
        // Hide all tab contents
        document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.remove('active');
        });
        
        // Remove active class from all nav links
        document.querySelectorAll('.nav-link').forEach(link => {
            link.classList.remove('active');
        });
        
        // Show selected tab content
        const selectedTab = document.getElementById(tabId);
        if (selectedTab) {
            selectedTab.classList.add('active');
        }
        
        // Find and activate the corresponding nav link
        document.querySelectorAll('.nav-link').forEach(link => {
            const onclickAttr = link.getAttribute('onclick');
            if (onclickAttr && onclickAttr.includes(`'${tabId}'`)) {
                link.classList.add('active');
            }
        });
        
        return false;
    }

    // Update employee status
    async function updateEmployeeStatus(employeeId, status) {
        try {
            const response = await fetch('dashboard.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `action=update_employee_status&employee_id=${employeeId}&status=${status}`
            });
            
            const result = await response.json();
            if (result.success) {
                // Update the card's visual status
                const card = document.getElementById(`emp-${employeeId}`);
                if (card) {
                    card.className = `employee-card ${status}`;
                    card.dataset.status = status;
                }
                console.log('Employee status updated successfully');
            } else {
                alert('Error updating status');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error updating status');
        }
    }

    // Refresh dashboard data
    async function refreshDashboard() {
        try {
            const response = await fetch('dashboard.php', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'action=refresh_data'
            });
            
            const result = await response.json();
            if (result.success) {
                location.reload(); // Simple refresh for now
            } else {
                console.error('Failed to refresh data');
            }
        } catch (error) {
            console.error('Refresh error:', error);
            location.reload(); // Fallback to page reload
        }
    }

    // Generate report
    function generateReport() {
        alert('📊 Generating comprehensive productivity report...\n\nThis will include:\n• Team performance metrics\n• Individual productivity scores\n• Project completion rates\n• Capacity utilization\n• Trend analysis');
    }

    // Show employee details
    function showEmployeeDetails(employeeId) {
        alert(`👤 Employee details for ID: ${employeeId}\n\nThis will open a detailed view with:\n• Individual performance metrics\n• Task breakdown\n• Recent activity\n• Productivity trends`);
    }

    // Filter team
    function filterTeam(filter) {
        const cards = document.querySelectorAll('.employee-card');
        
        cards.forEach(card => {
            if (filter === 'all') {
                card.style.display = 'block';
            } else if (filter === 'active') {
                card.style.display = card.dataset.status === 'active' ? 'block' : 'none';
            } else if (filter === 'overloaded') {
                const capacity = card.querySelector('.capacity-indicator');
                card.style.display = capacity && capacity.classList.contains('capacity-overloaded') ? 'block' : 'none';
            }
        });
    }

    // Enhanced Projects Functions
    function filterProjects(filter) {
        const cards = document.querySelectorAll('.project-card');
        
        cards.forEach(card => {
            const priority = card.dataset.priority;
            const health = parseInt(card.dataset.health);
            
            let show = false;
            
            switch(filter) {
                case 'all':
                    show = true;
                    break;
                case 'urgent':
                    show = priority === 'urgent';
                    break;
                case 'at-risk':
                    show = health < 70;
                    break;
                case 'on-track':
                    show = health >= 80;
                    break;
            }
            
            card.style.display = show ? 'block' : 'none';
        });
        
        // Update filter button states
        if (event && event.target) {
            document.querySelectorAll('.project-filters .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
        }
    }

    function viewProjectDetails(projectId) {
        alert(`📋 Opening detailed view for Project ${projectId}...\n\n• Full task breakdown\n• Timeline visualization\n• Team performance metrics\n• Budget tracking\n• Risk assessment\n• Client communication log`);
    }

    function editProject(projectId) {
        alert(`✏️ Opening project editor for Project ${projectId}...\n\n• Edit project details\n• Adjust timeline\n• Reassign team members\n• Update budget\n• Modify priority level`);
    }

    // Enhanced Productivity Functions
    function viewAllPerformers() {
        alert(`👥 Opening full team performance dashboard...\n\n• Individual productivity scores\n• Historical performance trends\n• Goal tracking\n• Performance insights\n• Recognition & feedback system`);
    }

    function rebalanceWorkload() {
        alert(`⚖️ Initiating workload rebalancing...\n\n• Analyzing current capacity\n• Identifying task redistribution opportunities\n• Suggesting optimal assignments\n• Preventing burnout risks\n• Maximizing team efficiency`);
    }

    function generateDetailedReport() {
        alert(`📊 Generating comprehensive productivity report...\n\n• Team performance metrics\n• Project health analysis\n• Productivity trends\n• Bottleneck identification\n• Workload distribution\n• Actionable recommendations`);
    }

    function scheduleStandup() {
        alert(`📅 Opening standup scheduler...\n\n• Available team member slots\n• Suggested optimal times\n• Agenda template\n• Meeting room booking\n• Calendar integration`);
    }

    // Capacity Management Functions
    function filterCapacity(filter) {
        const cards = document.querySelectorAll('.capacity-person-card');
        
        cards.forEach(card => {
            const status = card.dataset.status;
            
            let show = false;
            switch(filter) {
                case 'all':
                    show = true;
                    break;
                case 'overloaded':
                    show = status === 'overloaded';
                    break;
                case 'optimal':
                    show = status === 'optimal';
                    break;
                case 'available':
                    show = status === 'available';
                    break;
            }
            
            if (show) {
                card.style.display = 'block';
                card.style.animation = 'fadeInUp 0.3s ease-out';
            } else {
                card.style.display = 'none';
            }
        });
        
        // Update filter button states
        if (event && event.target) {
            document.querySelectorAll('.capacity-filter').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
        }
    }

    function adjustCapacity(employeeId) {
        alert(`⚖️ Adjusting capacity for Employee ${employeeId}...\n\n• Current workload analysis\n• Task redistribution options\n• Skill-based reassignment\n• Workload balancing\n• Burnout prevention measures\n• Capacity optimization`);
    }

    function viewSchedule(employeeId) {
        alert(`📅 Opening schedule for Employee ${employeeId}...\n\n• Current assignments\n• Upcoming deadlines\n• Available time slots\n• Meeting calendar\n• Vacation schedule\n• Project timeline`);
    }

    // Reports Functions
    function exportReport(type) {
        alert(`📄 Exporting ${type} report...\n\n• Generating PDF format\n• Including all charts and data\n• Executive summary\n• Detailed analytics\n• Recommendation section\n• Ready for client presentation`);
    }

    function scheduleReport() {
        alert(`📅 Setting up automated reports...\n\n• Daily team summaries\n• Weekly performance reports\n• Monthly executive dashboards\n• Quarterly business reviews\n• Custom report triggers\n• Email distribution lists`);
    }

    function exportAllReports() {
        alert(`📦 Exporting comprehensive report package...\n\n• Executive summary (PDF)\n• Financial reports (Excel)\n• Team analytics (PDF)\n• Project data (CSV)\n• Client analysis (PDF)\n• Charts and visualizations`);
    }

    function emailReports() {
        alert(`📧 Setting up report email distribution...\n\n• Stakeholder mailing lists\n• Custom report schedules\n• Automated delivery\n• Executive summaries\n• Department-specific reports\n• Real-time alerts`);
    }

    function scheduleReports() {
        alert(`⏰ Configuring automated report scheduling...\n\n• Daily operational reports\n• Weekly team summaries\n• Monthly executive reviews\n• Quarterly board reports\n• Custom trigger conditions\n• Multi-format delivery`);
    }

    function customizeReports() {
        alert(`🎨 Opening report customization panel...\n\n• Custom metrics selection\n• Brand styling options\n• Data visualization types\n• Report templates\n• Filtering criteria\n• Export format preferences`);
    }

    // Logout
    function logout() {
        if (confirm('Are you sure you want to logout?')) {
            window.location.href = 'auth.php?action=logout';
        }
    }

    // Auto-refresh every 30 seconds
    setInterval(() => {
        if (document.getElementById('overview').classList.contains('active')) {
            // Could implement AJAX refresh here
            console.log('Auto-refresh check - Overview tab active');
        }
    }, 30000);

    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey || e.metaKey) {
            switch(e.key) {
                case '1': e.preventDefault(); showTab('overview'); break;
                case '2': e.preventDefault(); showTab('team'); break;
                case '3': e.preventDefault(); showTab('productivity'); break;
                case '4': e.preventDefault(); showTab('capacity'); break;
                case '5': e.preventDefault(); showTab('projects'); break;
                case '6': e.preventDefault(); showTab('reports'); break;
                case 'r': e.preventDefault(); refreshDashboard(); break;
                case 'e': e.preventDefault(); window.location.href = 'employee_dashboard.php?test_employee=1'; break;
            }
        }
    });

    // Initialize dashboard
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Foxhole Dashboard initialized');
        
        // Check if we're in test mode
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('admin_test')) {
            console.log('Running in admin test mode');
        }
        
        // Add loading states to buttons
        document.querySelectorAll('.btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Don't add loading state to nav buttons
                if (this.closest('.nav-menu')) return;
                
                const originalText = this.innerHTML;
                this.innerHTML = '<div class="spinner"></div> Loading...';
                setTimeout(() => {
                    this.innerHTML = originalText;
                }, 1000);
            });
        });
    });

    // Error handling for development
    window.addEventListener('error', function(e) {
        console.error('Dashboard Error:', e.error);
    });

    // Handle unhandled promise rejections
    window.addEventListener('unhandledrejection', function(e) {
        console.error('Unhandled Promise Rejection:', e.reason);
    });
</script>

<script>
// Debug script - Add this right before </body> tag
console.log('Debug: Script loaded');

// Test if showTab function exists
console.log('showTab function exists:', typeof showTab);

// Override showTab with debug version
window.showTab = function(tabId, event) {
    console.log('showTab called with:', tabId, event);
    
    if (event) {
        event.preventDefault();
    }
    
    // Check if tab exists
    const tab = document.getElementById(tabId);
    console.log('Tab element found:', tab ? 'Yes' : 'No');
    
    // Hide all tabs
    const allTabs = document.querySelectorAll('.tab-content');
    console.log('Total tabs found:', allTabs.length);
    allTabs.forEach(content => {
        content.classList.remove('active');
    });
    
    // Show selected tab
    if (tab) {
        tab.classList.add('active');
        console.log('Tab activated:', tabId);
    }
    
    // Update nav links
    const allLinks = document.querySelectorAll('.nav-link');
    console.log('Total nav links found:', allLinks.length);
    
    allLinks.forEach(link => {
        link.classList.remove('active');
        const onclick = link.getAttribute('onclick');
        if (onclick && onclick.includes(tabId)) {
            link.classList.add('active');
            console.log('Nav link activated for:', tabId);
        }
    });
    
    return false;
};

// Test function on page load
document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM loaded');
    
